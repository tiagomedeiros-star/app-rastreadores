// Prepara o texto para ir dentro do JSON (escapa aspas, barras e quebras de linha)
String jsonEscape(const String& texto) {
  String saida;
  saida.reserve(texto.length() + 16);
  for (size_t i = 0; i < texto.length(); i++) {
    char c = texto[i];
    if (c == '"')       saida += "\\\"";
    else if (c == '\\') saida += "\\\\";
    else if (c == '\n') saida += "\\n";
    else if (c == '\r') { /* ignora */ }
    else if (c == '\t') saida += "\\t";
    else if ((uint8_t)c < 32 || (uint8_t)c > 126) saida += '?';  // ruído elétrico
    else saida += c;
  }
  return saida;
}

// ==========================================
// ROTAS DO SERVIDOR
// ==========================================

// ROTA 1: página principal (como o '/' do Flask)
void rotaIndex() {
  server.send_P(200, "text/html; charset=utf-8", HTML_PAGE);
}

// ROTA 2: recebe o comando, manda pro rastreador e devolve a resposta
void rotaEnviar() {
  String cmd = server.arg("comando");
  cmd.trim();

  if (cmd.length() == 0) {
    server.send(200, "application/json", "{\"resposta\":\"[ERRO] Comando vazio.\"}");
    return;
  }

  // Limpa sujeira antiga da porta
  while (Serial1.available()) Serial1.read();

  // Envia o comando + ENTER para o CalAmp
  Serial1.print(cmd);
  Serial1.write(ENTER);

  // Espera 1 segundo pro rastreador processar
  delay(1000);

  // Lê tudo que o rastreador devolveu
  String resposta;
  while (Serial1.available()) {
    resposta += (char)Serial1.read();
  }
  resposta.trim();

  if (resposta.length() == 0) {
    resposta = "[Timeout] Nenhuma resposta do módulo.";
  }

  server.send(200, "application/json", "{\"resposta\":\"" + jsonEscape(resposta) + "\"}");
}

// ==========================================
// SETUP E LOOP
// ==========================================
void setup() {
  Serial.begin(115200);   // USB (monitor serial do VS Code)
  delay(2000);            // dá tempo da USB abrir pra você ver as mensagens

  // Porta que conversa com o rastreador
  Serial1.begin(BAUD, SERIAL_8N1, RX_PIN, TX_PIN);

  // Conecta no WiFi
  WiFi.mode(WIFI_STA);
  // Se sua Super Mini não conectar de jeito nenhum, descomente a linha abaixo
  // (algumas placas têm antena fraca e funcionam melhor com potência menor):
  // WiFi.setTxPower(WIFI_POWER_8_5dBm);
  WiFi.begin(WIFI_SSID, WIFI_SENHA);

  Serial.print("Conectando ao WiFi");
  int tentativas = 0;
  while (WiFi.status() != WL_CONNECTED && tentativas < 40) {  // ~20 s
    delay(500);
    Serial.print(".");
    tentativas++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi conectado!");
    Serial.print("Acesse no celular: http://");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\nFalha ao conectar. Confira nome e senha do WiFi.");
  }

  // Registra as rotas e liga o servidor
  server.on("/", HTTP_GET, rotaIndex);
  server.on("/enviar", HTTP_POST, rotaEnviar);
  server.begin();
  Serial.println("Servidor web iniciado.");
}

void loop() {
  server.handleClient();  // atende quem acessar o site
}
